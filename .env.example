# PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Gateway
GATEWAY_ADDR=:8080
# Local development only: accept webhooks without verifying the PayPal signature.
# Leave false anywhere a real tunnel is exposed.
GATEWAY_SKIP_SIGNATURE_VERIFY=false

# Redpanda
REDPANDA_PROXY_URL=http://redpanda:8082

# Pipeline services
CASE_SERVICE_ADDR=:8081
MANDATE_SERVICE_ADDR=:8082
# Base64 Ed25519 private key for the mandate ledger. Leave unset and the
# service generates a throwaway key and logs it, which is fine for a first
# run but starts a new chain on every restart: mandates signed with the old
# key can no longer be verified. Set it to keep one verifiable ledger.
#   docker compose run --rm mandate 2>&1 | grep MANDATE_SIGNING_KEY
MANDATE_SIGNING_KEY=
# Where the demo agent posts its mandate.
MANDATE_SERVICE_URL=http://localhost:8083

# Postgres
POSTGRES_USER=countersign
POSTGRES_PASSWORD=countersign
POSTGRES_DB=countersign
DATABASE_URL=postgres://countersign:countersign@postgres:5432/countersign?sslmode=disable

# AI service
COST_TO_FIGHT_DEFAULT=25.00
# Path to the trained fraud model artifact. Unset means the fraud signal is neutral.
FRAUD_MODEL_PATH=
