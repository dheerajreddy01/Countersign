# PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Gateway
GATEWAY_ADDR=:8080
# Local development only: accept webhooks without verifying the PayPal
# signature. Leave false anywhere a tunnel is exposed — with it true, anyone who
# learns the URL can post events into the pipeline. False requires the three
# PAYPAL_* values above; the gateway refuses to start without them.
GATEWAY_SKIP_SIGNATURE_VERIFY=false

# Redpanda
REDPANDA_PROXY_URL=http://redpanda:8082

# Pipeline services
CASE_SERVICE_ADDR=:8081
MANDATE_SERVICE_ADDR=:8082
# Base64 Ed25519 private key for the mandate ledger. Leave unset and the
# service generates a throwaway key and logs it, which is fine for a first
# run but starts a new chain on every restart: mandates signed with the old
# key can no longer be verified. Set it to keep one verifiable ledger.
#   docker compose run --rm mandate 2>&1 | grep MANDATE_SIGNING_KEY
MANDATE_SIGNING_KEY=
# Where the demo agent posts its mandate.
MANDATE_SERVICE_URL=http://localhost:8083

# Postgres
POSTGRES_USER=countersign
POSTGRES_PASSWORD=countersign
POSTGRES_DB=countersign
DATABASE_URL=postgres://countersign:countersign@postgres:5432/countersign?sslmode=disable

# Service-to-service auth
# Shared secret the console presents to the case service on the action endpoint
# (which can refund a buyer), so that endpoint is not callable by anything else
# on the network. Set the same value on the console and the case service; unset,
# the check is off (fine for a single-machine demo). compose defaults both to a
# dev value; Render generates one and injects it into both.
INTERNAL_API_TOKEN=

# Evidence builder
# Where the evidence builder reaches the AI service to score and draft. In
# compose this is injected (http://ai:8000); set it when running the binary by
# hand. Unset, evidence is still assembled but the case is not scored or drafted.
AI_SERVICE_URL=http://localhost:8000

# Executor (PayPal Disputes API actions)
# With the PAYPAL_* values above set, approved actions are real submissions;
# unset, the executor simulates every action and labels the outcome.
#   EXECUTOR_SIMULATE        force simulation even when PayPal is configured
#   EXECUTOR_SIMULATE_RULING emit a labeled terminal ruling so the board reaches
#                            a final state (a real sandbox ruling can take days)
#   EXECUTOR_RULING          which simulated verdict to emit: won | lost
EXECUTOR_SIMULATE=
EXECUTOR_SIMULATE_RULING=true
EXECUTOR_RULING=won

# AI service
COST_TO_FIGHT_DEFAULT=25.00
# Path to the trained fraud model artifact. Unset means the fraud signal is neutral.
FRAUD_MODEL_PATH=
# Groq LLM for draft generation (https://console.groq.com/keys). Unset, POST
# /draft uses the deterministic template drafter. When set, the LLM writes the
# rebuttal and the grounding guard still gates it; an ungrounded draft falls
# back to the template. GROQ_MODEL is optional; it defaults to a served Groq
# model (see llm.py). Groq rotates model ids, so check GET /openai/v1/models
# if draft responses start coming back with source=template.
GROQ_API_KEY=
GROQ_MODEL=
