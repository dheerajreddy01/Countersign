# Optional. When set, route handlers proxy to the Go console API instead of
# serving the built-in demo fixtures.
CONSOLE_API_URL=

# Optional. When set, the console calls the Python AI service (services/ai;
# default http://localhost:8000 in docker-compose) for:
#   - POST /api/score            -> /score   (else local mirror of the rule)
#   - PUT  /api/cases/:id/draft  -> /ground  (authoritative grounding guard)
#   - POST /api/cases/:id/draft  -> /draft   (grounded draft generation)
# Unset, the console uses its local mirror for scoring and grounding, and draft
# generation is disabled (no local drafter) so it runs fully standalone.
AI_SERVICE_URL=
